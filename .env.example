# Copia este archivo como ".env" y ajusta la URL según tu entorno.
# En Vercel: no subas un .env — configura esta misma variable en
# Project Settings > Environment Variables, con la URL pública de tu backend
# en Railway, ej: VITE_API_URL=https://tu-backend.up.railway.app/api/v1
VITE_API_URL=http://localhost:8000/api/v1
